# 复制到仓库根目录 .env，绝不能提交真实密码或授权码。
DATABASE_URL="postgresql://USERNAME:PASSWORD@DATABASE_HOST:5432/wechatsend?schema=public"
DB_CONNECTION_LIMIT=4
DB_POOL_TIMEOUT=20

# 使用 1Panel 已有 Redis。API/Worker 会加入 1Panel 的共享 Docker 网络。
# 先用 docker ps 确认真实 Redis 容器名；/2 是本项目使用的独立逻辑库。
ONEPANEL_NETWORK="1panel-network"
# 无密码：redis://REDIS_CONTAINER_NAME:6379/2
# 有密码：redis://:URL_ENCODED_PASSWORD@REDIS_CONTAINER_NAME:6379/2
REDIS_URL="redis://REDIS_CONTAINER_NAME:6379/2"
WORKER_CONCURRENCY=4
API_PORT=3100
APP_ORIGIN="https://你的域名"
SESSION_TTL_DAYS=30
WEB_PORT=8080

SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_MAX_CONNECTIONS=1
SMTP_CONNECTION_TIMEOUT_MS=20000
SMTP_SOCKET_TIMEOUT_MS=60000

DEFAULT_TRIGGER_SUBJECT="WeChatSend"
VERIFY_SUBJECT="WeChatSend 邮箱验证（请勿触发快捷指令）"

# P3/P4/P5。APP_ENCRYPTION_KEY 用于加密 AI/API 密钥，必须至少 32 位。
APP_ENCRYPTION_KEY="请替换为至少32位随机字符串且保存后不可随意更换"
AI_REQUEST_TIMEOUT_MS=45000

# 微信小程序身份登录
WECHAT_MINI_APPID=""
WECHAT_MINI_SECRET=""
WECHAT_MINI_ENV_VERSION=release
# 仅 develop / trial 环境可展示 ticket，正式 release 始终隐藏。
AUTH_SHOW_DEV_TICKET=false

# 微信支付 V3；不启用支付时可以留空。私钥/证书可用 \n 表示换行。
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_PLATFORM_CERT=""
WECHAT_PAY_NOTIFY_URL="https://你的域名/api/v1/payments/notify"

# Web 端支付宝订单码支付。沙箱联调使用 sandbox 网关，正式环境改为 https://openapi.alipay.com/gateway.do。
ALIPAY_GATEWAY="https://openapi-sandbox.dl.alipaydev.com/gateway.do"
ALIPAY_APP_ID=""
ALIPAY_PRIVATE_KEY=""
ALIPAY_KEY_TYPE=PKCS1
ALIPAY_PUBLIC_KEY=""
ALIPAY_SELLER_ID=""
ALIPAY_NOTIFY_URL="https://你的域名/api/v1/alipay/notify"
ALIPAY_ORDER_EXPIRE_MINUTES=30
