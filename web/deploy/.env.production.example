# 复制到仓库根目录 .env，绝不能提交真实密码或授权码。
DATABASE_URL="postgresql://USERNAME:PASSWORD@DATABASE_HOST:5432/wechatsend?schema=public"
DB_CONNECTION_LIMIT=4
DB_POOL_TIMEOUT=20

WORKER_CONCURRENCY=4
API_PORT=3100
APP_ORIGIN="https://你的域名"
SESSION_TTL_DAYS=30
WEB_PORT=8080

SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_MAX_CONNECTIONS=1
SMTP_CONNECTION_TIMEOUT_MS=20000
SMTP_SOCKET_TIMEOUT_MS=60000

DEFAULT_TRIGGER_SUBJECT="WeChatSend"
VERIFY_SUBJECT="WeChatSend 邮箱验证（请勿触发快捷指令）"
