generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum FriendStatus {
  ACTIVE
  DISABLED
}

enum TaskStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum MessageStatus {
  PENDING
  SENDING
  ACCEPTED
  RETRY_WAIT
  FAILED
  UNKNOWN
  NEEDS_REVIEW
  CANCELLED
  SKIPPED
}

enum AttemptStatus {
  STARTED
  ACCEPTED
  FAILED
  UNKNOWN
}

enum FeedbackStatus {
  SUCCESS
  FAILED
}

enum TemplateScope {
  PLATFORM
  USER
}

enum VariableMode {
  FIXED
  RANDOM
  SEQUENCE
}

enum AiChannelType {
  OPENAI_COMPATIBLE
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CLOSED
  REFUNDED
}

enum VirtualMessageMode {
  PLAINTEXT
  COMPATIBLE
  SECURE
}

enum VirtualDataFormat {
  XML
  JSON
}

enum VirtualPaymentOrderStatus {
  PENDING
  PAID
  DELIVERED
  FAILED
  CLOSED
  REFUNDED
}

enum MembershipGrantSource {
  WECHAT_VIRTUAL
  ALIPAY
}

enum AlipayOrderStatus {
  PENDING
  PAID
  CLOSED
  FAILED
  REFUNDED
}

model User {
  id                      String                @id @default(uuid()) @db.Uuid
  username                String                @unique
  passwordHash            String                @map("password_hash")
  role                    UserRole              @default(USER)
  timezone                String                @default("Asia/Shanghai")
  miniOpenid              String?               @unique @map("mini_openid")
  miniUnionid             String?               @map("mini_unionid")
  nickname                String?
  avatarUrl               String?               @map("avatar_url")
  miniSessionKeyEncrypted String?               @map("mini_session_key_encrypted")
  status                  UserStatus            @default(ACTIVE)
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  sessions                Session[]
  accounts                WechatAccount[]
  friends                 Friend[]
  tasks                   Task[]
  friendGroups            FriendGroup[]
  friendTags              FriendTag[]
  templates               MessageTemplate[]
  templateFavorites       TemplateFavorite[]
  variables               CustomVariable[]
  drafts                  TaskDraft[]
  paymentOrders           PaymentOrder[]
  virtualPaymentOrders    VirtualPaymentOrder[]
  alipayOrders            AlipayOrder[]
  membershipGrants        MembershipGrant[]

  @@map("users")
}

model AiChannel {
  id              String        @id @default(uuid()) @db.Uuid
  name            String
  type            AiChannelType @default(OPENAI_COMPATIBLE)
  baseUrl         String        @map("base_url")
  encryptedApiKey String        @map("encrypted_api_key")
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  models          AiModel[]

  @@index([isActive, updatedAt])
  @@map("ai_channels")
}

model AiModel {
  id            String    @id @default(uuid()) @db.Uuid
  channelId     String    @map("channel_id") @db.Uuid
  name          String
  displayName   String?   @map("display_name")
  isActive      Boolean   @default(true) @map("is_active")
  contextWindow Int?      @map("context_window")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  channel       AiChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, name])
  @@index([isActive, channelId])
  @@map("ai_models")
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  config    Json?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model ApiIntegration {
  id               String                   @id @default(uuid()) @db.Uuid
  name             String
  url              String
  method           HttpMethod
  encryptedHeaders String?                  @map("encrypted_headers")
  requestParams    Json?                    @map("request_params")
  enabled          Boolean                  @default(true)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  variables        ApiIntegrationVariable[]

  @@index([enabled, updatedAt])
  @@map("api_integrations")
}

model ApiIntegrationVariable {
  id            String         @id @default(uuid()) @db.Uuid
  integrationId String         @map("integration_id") @db.Uuid
  name          String
  displayName   String         @map("display_name")
  responsePath  String         @map("response_path")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  integration   ApiIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, name])
  @@index([name])
  @@map("api_integration_variables")
}

model PaymentOrder {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String?       @map("user_id") @db.Uuid
  sceneToken    String?       @unique @map("scene_token")
  outTradeNo    String        @unique @map("out_trade_no")
  openid        String?
  description   String
  amountFen     Int           @map("amount_fen")
  status        PaymentStatus @default(PENDING)
  prepayId      String?       @map("prepay_id")
  transactionId String?       @map("transaction_id")
  notifyAt      DateTime?     @map("notify_at")
  expiresAt     DateTime      @map("expires_at")
  notifyRaw     Json?         @map("notify_raw")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("payment_orders")
}

model VirtualPaymentConfig {
  id                      String             @id @default("default")
  appId                   String             @map("app_id")
  offerId                 String             @map("offer_id")
  encryptedAppKey         String             @map("encrypted_app_key")
  pushToken               String             @map("push_token")
  encryptedEncodingAesKey String?            @map("encrypted_encoding_aes_key")
  messageMode             VirtualMessageMode @default(PLAINTEXT) @map("message_mode")
  dataFormat              VirtualDataFormat  @default(XML) @map("data_format")
  env                     Int                @default(0)
  notifyUrl               String?            @map("notify_url")
  enabled                 Boolean            @default(false)
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")

  @@map("virtual_payment_configs")
}

model MembershipPlan {
  id             String                @id @default(uuid()) @db.Uuid
  code           String                @unique
  name           String
  productId      String                @map("product_id")
  description    String
  priceFen       Int                   @map("price_fen")
  membershipDays Int                   @default(30) @map("membership_days")
  messageQuota   Int                   @default(0) @map("message_quota")
  sortOrder      Int                   @default(0) @map("sort_order")
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  orders         VirtualPaymentOrder[]
  alipayOrders   AlipayOrder[]
  grants         MembershipGrant[]

  @@index([isActive, sortOrder])
  @@map("membership_plans")
}

model VirtualPaymentOrder {
  id          String                    @id @default(uuid()) @db.Uuid
  userId      String                    @map("user_id") @db.Uuid
  planId      String                    @map("plan_id") @db.Uuid
  outTradeNo  String                    @unique @map("out_trade_no")
  wxOrderId   String?                   @unique @map("wx_order_id")
  openid      String
  productId   String                    @map("product_id")
  quantity    Int                       @default(1)
  amountFen   Int                       @map("amount_fen")
  attach      String
  status      VirtualPaymentOrderStatus @default(PENDING)
  expiresAt   DateTime                  @map("expires_at")
  paidAt      DateTime?                 @map("paid_at")
  deliveredAt DateTime?                 @map("delivered_at")
  queriedAt   DateTime?                 @map("queried_at")
  notifyRaw   Json?                     @map("notify_raw")
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        MembershipPlan            @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@index([openid, status])
  @@map("virtual_payment_orders")
}

model AlipayOrder {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  planId        String            @map("plan_id") @db.Uuid
  outTradeNo    String            @unique @map("out_trade_no")
  tradeNo       String?           @unique @map("trade_no")
  subject       String
  amountFen     Int               @map("amount_fen")
  status        AlipayOrderStatus @default(PENDING)
  qrCode        String?           @map("qr_code")
  expiresAt     DateTime          @map("expires_at")
  paidAt        DateTime?         @map("paid_at")
  notifyAt      DateTime?         @map("notify_at")
  notifyRaw     Json?             @map("notify_raw")
  failureReason String?           @map("failure_reason")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          MembershipPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, expiresAt])
  @@map("alipay_orders")
}

model MembershipGrant {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  planId        String                @map("plan_id") @db.Uuid
  source        MembershipGrantSource
  sourceOrderId String                @map("source_order_id")
  quantity      Int                   @default(1)
  quotaTotal    Int                   @default(0) @map("quota_total")
  quotaUsed     Int                   @default(0) @map("quota_used")
  startsAt      DateTime              @map("starts_at")
  expiresAt     DateTime              @map("expires_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          MembershipPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@unique([source, sourceOrderId])
  @@index([userId, expiresAt])
  @@map("membership_grants")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model WechatAccount {
  id                String                @id @default(uuid()) @db.Uuid
  ownerId           String                @map("owner_id") @db.Uuid
  name              String
  recipientEmail    String                @map("recipient_email")
  subject           String                @default("WeChatSend")
  minDelay          Int                   @default(10) @map("min_delay")
  maxDelay          Int                   @default(15) @map("max_delay")
  emailVerifiedAt   DateTime?             @map("email_verified_at")
  verificationHash  String?               @map("verification_hash")
  verificationUntil DateTime?             @map("verification_until")
  status            AccountStatus         @default(ACTIVE)
  configVersion     Int                   @default(1) @map("config_version")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  owner             User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  friends           Friend[]
  groups            FriendGroup[]
  tags              FriendTag[]
  taskSettings      TaskAccountSetting[]
  messages          TaskMessage[]
  dispatchState     AccountDispatchState?

  @@unique([ownerId, recipientEmail])
  @@index([ownerId, status])
  @@map("wechat_accounts")
}

model Friend {
  id               String              @id @default(uuid()) @db.Uuid
  ownerId          String              @map("owner_id") @db.Uuid
  accountId        String              @map("account_id") @db.Uuid
  remark           String
  remarkKey        String              @map("remark_key")
  salutation       String?
  status           FriendStatus        @default(ACTIVE)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  owner            User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  account          WechatAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages         TaskMessage[]
  groupMemberships FriendGroupMember[]
  tagMemberships   FriendTagMember[]

  @@unique([accountId, remarkKey])
  @@index([ownerId, accountId, status])
  @@map("friends")
}

model FriendGroup {
  id        String              @id @default(uuid()) @db.Uuid
  ownerId   String              @map("owner_id") @db.Uuid
  accountId String              @map("account_id") @db.Uuid
  name      String
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  owner     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  account   WechatAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members   FriendGroupMember[]

  @@unique([accountId, name])
  @@index([ownerId, accountId])
  @@map("friend_groups")
}

model FriendGroupMember {
  groupId   String      @map("group_id") @db.Uuid
  friendId  String      @map("friend_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  group     FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  friend    Friend      @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@id([groupId, friendId])
  @@index([friendId])
  @@map("friend_group_members")
}

model FriendTag {
  id        String            @id @default(uuid()) @db.Uuid
  ownerId   String            @map("owner_id") @db.Uuid
  accountId String            @map("account_id") @db.Uuid
  name      String
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  owner     User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  account   WechatAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  members   FriendTagMember[]

  @@unique([accountId, name])
  @@index([ownerId, accountId])
  @@map("friend_tags")
}

model FriendTagMember {
  tagId     String    @map("tag_id") @db.Uuid
  friendId  String    @map("friend_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  tag       FriendTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  friend    Friend    @relation(fields: [friendId], references: [id], onDelete: Cascade)

  @@id([tagId, friendId])
  @@index([friendId])
  @@map("friend_tag_members")
}

model MessageTemplate {
  id        String             @id @default(uuid()) @db.Uuid
  ownerId   String?            @map("owner_id") @db.Uuid
  scope     TemplateScope      @default(USER)
  title     String
  content   String
  category  String?
  version   Int                @default(1)
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  owner     User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  favorites TemplateFavorite[]

  @@index([ownerId, scope, isActive])
  @@map("message_templates")
}

model TemplateFavorite {
  ownerId    String          @map("owner_id") @db.Uuid
  templateId String          @map("template_id") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at")
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template   MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([ownerId, templateId])
  @@map("template_favorites")
}

model CustomVariable {
  id          String                @id @default(uuid()) @db.Uuid
  ownerId     String                @map("owner_id") @db.Uuid
  name        String
  displayName String                @map("display_name")
  mode        VariableMode
  version     Int                   @default(1)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  values      CustomVariableValue[]

  @@unique([ownerId, name])
  @@index([ownerId, updatedAt])
  @@map("custom_variables")
}

model CustomVariableValue {
  id         String         @id @default(uuid()) @db.Uuid
  variableId String         @map("variable_id") @db.Uuid
  value      String
  position   Int
  variable   CustomVariable @relation(fields: [variableId], references: [id], onDelete: Cascade)

  @@unique([variableId, position])
  @@map("custom_variable_values")
}

model TaskDraft {
  id           String    @id @default(uuid()) @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  title        String
  content      String
  scheduledAt  DateTime? @map("scheduled_at")
  payload      Json
  sourceTaskId String?   @map("source_task_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@map("task_drafts")
}

model Task {
  id               String               @id @default(uuid()) @db.Uuid
  ownerId          String               @map("owner_id") @db.Uuid
  title            String
  content          String
  contentTemplate  String?              @map("content_template")
  templateSnapshot Json?                @map("template_snapshot")
  variableSnapshot Json?                @map("variable_snapshot")
  randomSeed       String?              @map("random_seed")
  scheduledAt      DateTime             @map("scheduled_at")
  status           TaskStatus           @default(SCHEDULED)
  idempotencyKey   String               @map("idempotency_key")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  owner            User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  accountSettings  TaskAccountSetting[]
  messages         TaskMessage[]

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, createdAt])
  @@map("tasks")
}

model TaskAccountSetting {
  id             String        @id @default(uuid()) @db.Uuid
  taskId         String        @map("task_id") @db.Uuid
  accountId      String        @map("account_id") @db.Uuid
  recipientEmail String        @map("recipient_email")
  subject        String
  configVersion  Int           @map("config_version")
  minDelay       Int           @map("min_delay")
  maxDelay       Int           @map("max_delay")
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  account        WechatAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([taskId, accountId])
  @@map("task_account_settings")
}

model TaskMessage {
  id                 String            @id @default(uuid()) @db.Uuid
  messageId          String            @unique @map("message_id")
  taskId             String            @map("task_id") @db.Uuid
  accountId          String            @map("account_id") @db.Uuid
  friendId           String            @map("friend_id") @db.Uuid
  friendRemark       String            @map("friend_remark")
  content            String
  recipientOrder     Int               @default(0) @map("recipient_order")
  recipientEmail     String            @map("recipient_email")
  subject            String
  minDelay           Int               @map("min_delay")
  maxDelay           Int               @map("max_delay")
  configVersion      Int               @map("config_version")
  status             MessageStatus     @default(PENDING)
  readyAt            DateTime          @map("ready_at")
  dispatchReservedAt DateTime?         @map("dispatch_reserved_at")
  acceptedAt         DateTime?         @map("accepted_at")
  feedbackStatus     FeedbackStatus?   @map("feedback_status")
  feedbackReceivedAt DateTime?         @map("feedback_received_at")
  feedbackError      String?           @map("feedback_error")
  errorCode          String?           @map("error_code")
  errorMessage       String?           @map("error_message")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  task               Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  account            WechatAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  friend             Friend            @relation(fields: [friendId], references: [id], onDelete: Restrict)
  attempts           DeliveryAttempt[]

  @@unique([taskId, accountId, friendId])
  @@index([accountId, status, readyAt])
  @@index([taskId, status])
  @@map("task_messages")
}

model DeliveryAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  messageId         String        @map("message_id") @db.Uuid
  sequence          Int
  status            AttemptStatus @default(STARTED)
  providerMessageId String?       @map("provider_message_id")
  errorCode         String?       @map("error_code")
  errorMessage      String?       @map("error_message")
  startedAt         DateTime      @default(now()) @map("started_at")
  completedAt       DateTime?     @map("completed_at")
  message           TaskMessage   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, sequence])
  @@map("delivery_attempts")
}

model AccountDispatchState {
  accountId       String        @id @map("account_id") @db.Uuid
  nextAllowedAt   DateTime      @default(now()) @map("next_allowed_at")
  lockedMessageId String?       @map("locked_message_id") @db.Uuid
  lockedUntil     DateTime?     @map("locked_until")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  account         WechatAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_dispatch_states")
}

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  aggregateId String    @map("aggregate_id") @db.Uuid
  payload     Json
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}
