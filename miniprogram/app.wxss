page { min-height: 100%; background: #f0fdf4; color: #12372d; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 32rpx; }
.eyebrow { font-family: monospace; font-size: 20rpx; letter-spacing: 4rpx; color: #a3a3a3; text-transform: uppercase; }
.title { margin-top: 12rpx; font-size: 52rpx; line-height: 1.2; font-weight: 650; letter-spacing: -2rpx; }
.subtitle { margin-top: 12rpx; font-size: 26rpx; line-height: 1.6; color: #737373; }
.card { margin-top: 24rpx; padding: 32rpx; border: 1rpx solid #e5e5e5; border-radius: 20rpx; background: #fff; }
.card-title { font-size: 30rpx; font-weight: 600; }
.label { display: block; margin: 28rpx 0 12rpx; font-size: 24rpx; font-weight: 600; color: #404040; }
.input { box-sizing: border-box; width: 100%; height: 84rpx; padding: 0 24rpx; border: 1rpx solid #d4d4d4; border-radius: 12rpx; background: #fff; font-size: 28rpx; }
.textarea { box-sizing: border-box; width: 100%; min-height: 240rpx; padding: 22rpx 24rpx; border: 1rpx solid #d4d4d4; border-radius: 12rpx; background: #fff; font-size: 28rpx; line-height: 1.65; }
.button { display: flex; height: 84rpx; align-items: center; justify-content: center; margin: 0; border-radius: 12rpx; background: #047857; color: #fff; font-size: 28rpx; font-weight: 600; }
.button::after { border: 0; }
.button.secondary { border: 1rpx solid #a7f3d0; background: #fff; color: #047857; }
.button.small { width: auto; height: 64rpx; padding: 0 24rpx; font-size: 24rpx; }
.row { display: flex; align-items: center; }
.between { justify-content: space-between; }
.muted { color: #737373; }
.small { font-size: 24rpx; }
.divider { height: 1rpx; background: #eeeeec; }
.badge { display: inline-flex; margin-top: 8rpx; padding: 5rpx 14rpx; border: 1rpx solid #e5e5e5; border-radius: 999rpx; background: #fafafa; color: #525252; font-size: 20rpx; }
.empty { padding: 100rpx 30rpx; text-align: center; color: #737373; font-size: 26rpx; line-height: 1.7; }
.error { margin-top: 20rpx; padding: 22rpx; border: 1rpx solid #fecaca; border-radius: 12rpx; background: #fef2f2; color: #991b1b; font-size: 24rpx; }
