<view class="page"><view class="row between"><view><view class="eyebrow">VARIABLE STUDIO</view><view class="title">内容变量</view></view><button class="button small" bindtap="toggleForm">{{showForm ? '取消' : '新建'}}</button></view><view class="subtitle">固定、随机或按好友顺序填充。</view><view class="card builtins"><view class="card-title">内置变量</view><view class="chips"><text wx:for="{{builtIns}}" wx:key="*this">{{item}}</text></view></view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{showForm}}" class="card"><view class="card-title">{{editingId ? '编辑变量' : '创建变量'}}</view><text class="label">变量名</text><input class="input" value="{{name}}" data-key="name" bindinput="input" placeholder="product_name"/><text class="label">显示名称</text><input class="input" value="{{displayName}}" data-key="displayName" bindinput="input" placeholder="产品名称"/><text class="label">取值方式</text><picker mode="selector" range="{{modes}}" value="{{modeIndex}}" bindchange="modeChange"><view class="input picker">{{modes[modeIndex]}}</view></picker><text class="label">候选值</text><textarea class="textarea" value="{{raw}}" data-key="raw" bindinput="input" placeholder="一行一个，也支持逗号或分号"/><button class="button save" bindtap="save">保存变量</button></view>
  <view wx:for="{{items}}" wx:key="id" class="card variable"><view class="code">{{item.token}}</view><view class="card-title">{{item.displayName}}</view><view class="small muted">{{item.mode === 'FIXED' ? '固定值' : item.mode === 'RANDOM' ? '随机取值' : '按好友顺序'}} · {{item.values.length}} 个候选值 · V{{item.version}}</view><view class="chips values"><text wx:for="{{item.values}}" wx:for-item="value" wx:key="id">{{value.value}}</text></view><button class="button secondary small" data-id="{{item.id}}" bindtap="edit">编辑</button></view>
</view>
