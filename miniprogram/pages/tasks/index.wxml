<view class="page"><view class="row between"><view><view class="eyebrow">DISPATCH</view><view class="title">发送任务</view></view><button class="button small" bindtap="create">创建</button></view><view class="subtitle">邮件状态不代表微信送达。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!items.length}}" class="empty">还没有发送任务</view><view wx:for="{{items}}" wx:key="id" class="card task" data-id="{{item.id}}" bindtap="detail"><view class="row between"><view class="name">{{item.title}}</view><view class="badge">{{statusText[item.status] || item.status}}</view></view><view class="content">{{item.content}}</view><view class="meta"><text>{{item._count.messages}} 人</text><text>{{item.scheduledAtText}}</text></view></view></view>
