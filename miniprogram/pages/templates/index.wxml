<view class="page"><view class="row between"><view><view class="eyebrow">CONTENT LIBRARY</view><view class="title">文案模板</view></view><button class="button small" bindtap="toggleForm">{{showForm ? '取消' : '新建'}}</button></view><view class="subtitle">模板在提交任务时冻结版本。</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{showForm}}" class="card"><view class="card-title">{{editingId ? '编辑我的模板' : '创建我的模板'}}</view><text class="label">名称</text><input class="input" value="{{title}}" data-key="title" bindinput="input"/><text class="label">分类</text><input class="input" value="{{category}}" data-key="category" bindinput="input"/><text class="label">内容</text><textarea class="textarea" value="{{content}}" data-key="content" bindinput="input" placeholder="可使用好友称呼等变量"/><button class="button save" bindtap="save">保存模板</button></view>
  <view wx:for="{{items}}" wx:key="id" class="card template"><view class="row between"><view class="scope">{{item.scope === 'PLATFORM' ? '平台精选' : '我的模板 · V' + item.version}}</view><view class="favorite" data-id="{{item.id}}" bindtap="favorite">{{item.favorite ? '★' : '☆'}}</view></view><view class="card-title name">{{item.title}}</view><view class="category">{{item.category || '未分类'}}</view><view class="body">{{item.content}}</view><view class="actions"><button class="button" data-id="{{item.id}}" bindtap="use">使用</button><button wx:if="{{item.scope === 'USER'}}" class="button secondary" data-id="{{item.id}}" bindtap="edit">编辑</button><button wx:if="{{item.scope === 'PLATFORM'}}" class="button secondary" data-id="{{item.id}}" bindtap="copy">复制</button></view></view>
</view>
