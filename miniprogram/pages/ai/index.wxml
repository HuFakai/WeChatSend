<view class="page"><view class="eyebrow">AI STUDIO</view><view class="title">AI 助手</view><view class="subtitle">AI 只生成候选内容或草稿，不会绕过确认直接发送。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{options && !modes.length}}" class="empty">管理员尚未开启小程序 AI 功能。</view><view wx:if="{{options && modes.length && options.models.length}}" class="card"><text class="label">工作方式</text><picker mode="selector" range="{{modes}}" value="{{modeIndex}}" bindchange="modeChange"><view class="input picker">{{modes[modeIndex]}}</view></picker><text class="label">模型</text><picker mode="selector" range="{{options.models}}" range-key="displayName" value="{{modelIndex}}" bindchange="modelChange"><view class="input picker">{{options.models[modelIndex].channelName}} · {{options.models[modelIndex].displayName}}</view></picker><text class="label">需求描述</text><textarea class="textarea" value="{{prompt}}" bindinput="promptInput" placeholder="例如：写一段周末家居活动的客户邀约"/><text class="label">补充事实（选填）</text><textarea class="textarea short" value="{{context}}" bindinput="contextInput" placeholder="产品、时间、价格等由你确认的信息"/><button class="button submit" loading="{{loading}}" bindtap="generate">{{mode === 'TASK' ? '生成任务草稿' : '生成内容'}}</button></view><view wx:if="{{options && modes.length && !options.models.length}}" class="empty">管理员尚未配置可用 AI 模型。</view><view wx:if="{{result}}" class="card"><view class="card-title">候选结果</view><view class="result">{{result}}</view></view><view wx:if="{{!options && !error}}" class="empty">正在读取 AI 配置…</view></view>
