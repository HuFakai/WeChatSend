<view class="page"><view class="row between"><view><view class="eyebrow">CONTACTS</view><view class="title">好友管理</view></view><button class="button small" bindtap="toggleForm">{{showForm ? '取消' : '添加'}}</button></view><view class="subtitle">通过唯一微信备注匹配联系人。</view><picker mode="selector" range="{{accountNames}}" value="{{accountIndex}}" bindchange="accountChange"><view class="card picker">{{accountNames[accountIndex] || '请选择发送账号'}}<text>⌄</text></view></picker><view class="segment-actions"><button class="button secondary small" data-kind="groups" bindtap="createSegment">新建分组</button><button class="button secondary small" data-kind="tags" bindtap="createSegment">新建标签</button></view><view wx:if="{{groups.length || tags.length}}" class="card segment-manager"><view class="small muted">分组与标签管理</view><view wx:for="{{groups}}" wx:for-item="segment" wx:key="id" class="segment-row"><text>{{segment.name}} · {{segment.friendIds.length}}</text><view><button class="mini-action" data-kind="groups" data-id="{{segment.id}}" data-name="{{segment.name}}" bindtap="renameSegment">改名</button><button class="mini-action danger" data-kind="groups" data-id="{{segment.id}}" data-name="{{segment.name}}" bindtap="deleteSegment">删除</button></view></view><view wx:for="{{tags}}" wx:for-item="segment" wx:key="id" class="segment-row tag-row"><text>#{{segment.name}} · {{segment.friendIds.length}}</text><view><button class="mini-action" data-kind="tags" data-id="{{segment.id}}" data-name="{{segment.name}}" bindtap="renameSegment">改名</button><button class="mini-action danger" data-kind="tags" data-id="{{segment.id}}" data-name="{{segment.name}}" bindtap="deleteSegment">删除</button></view></view></view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{showForm}}" class="card"><view class="card-title">批量添加好友</view><textarea class="textarea remarks" value="{{raw}}" bindinput="rawInput" placeholder="用逗号、分号或换行分隔微信备注"/><view class="small muted count">识别到 {{parsedCount}} 个备注</view><button class="button" bindtap="create">确认添加</button></view>
  <view wx:if="{{!items.length && !showForm}}" class="empty">该账号还没有好友</view><view wx:for="{{items}}" wx:for-index="friendIndex" wx:key="id" class="card friend"><view class="avatar">友</view><view class="info"><view>{{item.remark}}</view><view wx:if="{{item.salutation}}" class="small muted">称呼 · {{item.salutation}}</view><view class="member-chips"><view wx:for="{{item.groupOptions}}" wx:for-item="segment" wx:key="id" class="member-chip {{segment.selected ? 'active' : ''}}" data-friend-index="{{friendIndex}}" data-kind="group" data-id="{{segment.id}}" catchtap="toggleSegment">{{segment.name}}</view><view wx:for="{{item.tagOptions}}" wx:for-item="segment" wx:key="id" class="member-chip tag {{segment.selected ? 'active' : ''}}" data-friend-index="{{friendIndex}}" data-kind="tag" data-id="{{segment.id}}" catchtap="toggleSegment">#{{segment.name}}</view></view><view class="badge">{{item.status === 'ACTIVE' ? '使用中' : '已停用'}}</view></view><view><button class="button secondary small friend-action" data-id="{{item.id}}" data-remark="{{item.remark}}" bindtap="edit">备注</button><button class="button secondary small friend-action" data-id="{{item.id}}" data-salutation="{{item.salutation}}" bindtap="editSalutation">称呼</button><button class="button secondary small friend-action" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="toggle">{{item.status === 'ACTIVE' ? '停用' : '启用'}}</button></view></view>
</view>
