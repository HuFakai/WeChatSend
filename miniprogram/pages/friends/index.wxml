<view class="page"><view class="row between"><view><view class="eyebrow">CONTACTS</view><view class="title">好友管理</view></view><button class="button small" bindtap="toggleForm">{{showForm ? '取消' : '添加'}}</button></view><view class="subtitle">通过唯一微信备注匹配联系人。</view><picker mode="selector" range="{{accountNames}}" value="{{accountIndex}}" bindchange="accountChange"><view class="card picker">{{accountNames[accountIndex] || '请选择发送账号'}}<text>⌄</text></view></picker><view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{showForm}}" class="card"><view class="card-title">批量添加好友</view><textarea class="textarea remarks" value="{{raw}}" bindinput="rawInput" placeholder="用逗号、分号或换行分隔微信备注"/><view class="small muted count">识别到 {{parsedCount}} 个备注</view><button class="button" bindtap="create">确认添加</button></view>
  <view wx:if="{{!items.length && !showForm}}" class="empty">该账号还没有好友</view><view wx:for="{{items}}" wx:key="id" class="card friend"><view class="avatar">友</view><view class="info"><view>{{item.remark}}</view><view class="badge">{{item.status === 'ACTIVE' ? '使用中' : '已停用'}}</view></view><view><button class="button secondary small friend-action" data-id="{{item.id}}" data-remark="{{item.remark}}" bindtap="edit">编辑</button><button class="button secondary small friend-action" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="toggle">{{item.status === 'ACTIVE' ? '停用' : '启用'}}</button></view></view>
</view>
