.picker { display: flex; justify-content: space-between; padding: 24rpx 28rpx; font-size: 26rpx; }.remarks { margin-top: 28rpx; }.count { margin: 18rpx 0; }.friend { display: flex; align-items: center; gap: 22rpx; }.avatar { display: flex; width: 72rpx; height: 72rpx; align-items: center; justify-content: center; border-radius: 50%; background: #f0f0ee; font-weight: 600; }.info { flex: 1; min-width: 0; font-size: 28rpx; }
.friend-action { margin-top: 8rpx; }
.segment-actions { display: flex; gap: 14rpx; margin-top: 18rpx; }.member-chips { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }.member-chip { padding: 5rpx 11rpx; border: 1rpx solid #ddd; border-radius: 999rpx; color: #999; font-size: 18rpx; }.member-chip.active { border-color: #047857; background: #047857; color: white; }.member-chip.tag { border-style: dashed; }
.segment-manager { padding-top: 16rpx; padding-bottom: 16rpx; }.segment-row { display: flex; align-items: center; justify-content: space-between; padding: 15rpx 0; border-bottom: 1rpx solid #eee; font-size: 23rpx; }.segment-row:last-child { border-bottom: 0; }.segment-row view { display: flex; gap: 8rpx; }.mini-action { width: auto; min-height: 0; margin: 0; padding: 7rpx 13rpx; border: 0; background: #ecfdf5; color: #065f46; font-size: 19rpx; line-height: 1.4; }.mini-action::after { border: 0; }.mini-action.danger { color: #b42318; }.tag-row > text { text-decoration: underline dotted #aaa; text-underline-offset: 5rpx; }
.import-actions { display: flex; gap: 16rpx; padding: 18rpx 32rpx 32rpx; background: #ecfdf5; }.import-actions .button { flex: 1; }
