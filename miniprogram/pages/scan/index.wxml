<view class="page"><view class="eyebrow">SECURE IDENTITY</view><view class="title">{{action==='BIND'?'绑定网页账号':'确认网页登录'}}</view><view class="card"><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{done}}" class="card-title">已确认，请返回网页继续使用。</view><block wx:else><view class="subtitle">{{action==='BIND'?'将微信身份与网页账号关联，并合并双方业务数据。':'仅在你本人正在登录 WeChatSend 网页时确认。'}}</view><view wx:if="{{account}}" class="note">目标账号：{{account}}</view><view wx:if="{{devTicket}}" class="note">开发 Ticket：{{devTicket}}</view><button class="button" disabled="{{busy || !action}}" loading="{{busy}}" bindtap="confirm">{{action==='BIND'?'确认绑定':'确认登录'}}</button></block><button class="button secondary" bindtap="cancel">返回个人中心</button></view></view>
