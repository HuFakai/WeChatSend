.title-row { align-items: flex-end; }
.task-title { max-width: 500rpx; }
.summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.stat { display: flex; min-height: 150rpx; padding: 24rpx 20rpx; flex-direction: column; justify-content: space-between; }
.number { font-family: monospace; font-size: 46rpx; }
.message { margin-top: 24rpx; padding: 24rpx; border-radius: 12rpx; background: #f5f5f3; font-size: 27rpx; line-height: 1.7; white-space: pre-wrap; }
.list { padding: 0; }
.heading { padding: 30rpx; }
.record { padding: 28rpx 30rpx; border-top: 1rpx solid #eee; font-size: 27rpx; }
.record-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.record-name { font-weight: 600; }
.record-id { max-width: 390rpx; margin-top: 8rpx; overflow-wrap: anywhere; color: #a3a3a3; font-family: monospace; font-size: 19rpx; }
.record-times { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 24rpx; padding: 22rpx; border-radius: 12rpx; background: #f7f7f5; }
.record-times view { display: flex; flex-direction: column; gap: 7rpx; font-size: 21rpx; }
.record-times text:first-child { color: #a3a3a3; }
.record-error { margin-top: 16rpx; color: #b91c1c; font-size: 21rpx; }
.record-action { display: flex; flex-direction: column; align-items: flex-end; }
.retry { width: 100%; height: 62rpx; margin-top: 18rpx; font-size: 22rpx; }
.interval-note { padding: 0 8rpx; font-size: 22rpx; }
.cancel { margin-top: 24rpx; }
