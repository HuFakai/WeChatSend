.account-block { margin-top: 34rpx; padding-top: 30rpx; border-top: 1rpx solid #eee; }.account-title { font-size: 27rpx; font-weight: 600; }.friend-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 20rpx; }.friend { display: flex; align-items: center; gap: 12rpx; padding: 20rpx; overflow: hidden; border: 1rpx solid #dedede; border-radius: 12rpx; font-size: 24rpx; }.friend text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.friend.selected { background: #0a0a0a; color: white; border-color: #0a0a0a; }.box { display: flex; width: 28rpx; height: 28rpx; align-items: center; justify-content: center; flex-shrink: 0; border: 1rpx solid currentColor; border-radius: 5rpx; font-size: 18rpx; }.delay,.date-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }.timing { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 28rpx; }.choice { padding: 25rpx; border: 1rpx solid #d4d4d4; border-radius: 12rpx; text-align: center; font-size: 26rpx; }.choice.selected { border-color: #0a0a0a; box-shadow: inset 0 0 0 1rpx #0a0a0a; }.date-row { margin-top: 20rpx; }.picker { display: flex; align-items: center; }.notice { margin: 24rpx 0; padding: 24rpx; border: 1rpx solid #e5e5e5; border-radius: 12rpx; color: #737373; font-size: 23rpx; line-height: 1.6; }.submit { margin-bottom: 40rpx; }
