<view class="page"><view class="eyebrow">NEW DISPATCH</view><view class="title">创建发送任务</view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card"><view class="card-title">01 · 消息内容</view><text class="label">任务名称</text><input class="input" value="{{title}}" bindinput="titleInput" placeholder="例如：客户节日问候"/><text class="label">微信消息</text><textarea class="textarea" value="{{content}}" bindinput="contentInput" placeholder="输入或粘贴纯文本消息"/></view>
  <view class="card"><view class="row between"><view class="card-title">02 · 选择好友</view><text class="small muted">{{total}} 人</text></view><view wx:for="{{selections}}" wx:for-item="selection" wx:for-index="accountIndex" wx:key="id" class="account-block"><view class="row between account-title"><view>{{selection.name}}</view><text class="small muted">{{selection.selectedCount}}/{{selection.friends.length}}</text></view><view class="friend-grid"><view wx:for="{{selection.friends}}" wx:for-item="friend" wx:for-index="friendIndex" wx:key="id" class="friend {{friend.selected ? 'selected' : ''}}" data-account-index="{{accountIndex}}" data-friend-index="{{friendIndex}}" bindtap="toggleFriend"><view class="box">{{friend.selected ? '✓' : ''}}</view><text>{{friend.remark}}</text></view></view><view wx:if="{{selection.selectedCount}}" class="delay"><view><text class="label">最小间隔（秒）</text><input class="input" type="number" min="10" value="{{selection.minDelay}}" data-account-index="{{accountIndex}}" data-key="minDelay" bindinput="delayInput"/></view><view><text class="label">最大间隔（秒）</text><input class="input" type="number" min="10" value="{{selection.maxDelay}}" data-account-index="{{accountIndex}}" data-key="maxDelay" bindinput="delayInput"/></view></view></view></view>
  <view class="card"><view class="card-title">03 · 开始时间</view><view class="timing"><view class="choice {{timing === 'now' ? 'selected' : ''}}" data-value="now" bindtap="timingChange">立即发送</view><view class="choice {{timing === 'later' ? 'selected' : ''}}" data-value="later" bindtap="timingChange">单次定时</view></view><view wx:if="{{timing === 'later'}}" class="date-row"><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="input picker">{{date}}</view></picker><picker mode="time" value="{{time}}" bindchange="timeChange"><view class="input picker">{{time}}</view></picker></view></view>
  <view class="notice">确认后，每位好友会独立生成一封标签文本邮件。邮件已发送不代表微信已送达。</view><button class="button submit" loading="{{busy}}" bindtap="submit">确认并提交 · {{total}} 人</button>
</view>
