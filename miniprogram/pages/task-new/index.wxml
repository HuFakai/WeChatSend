<view class="page"><view class="row between"><view><view class="eyebrow">NEW DISPATCH · P2</view><view class="title">{{draftId ? '继续编辑草稿' : '创建发送任务'}}</view></view><button class="button secondary small" loading="{{busy}}" bindtap="saveDraft">存草稿</button></view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="card"><view class="card-title">01 · 消息与变量</view><text class="label">任务名称</text><input class="input" value="{{title}}" bindinput="titleInput"/><text class="label">选择模板</text><picker mode="selector" range="{{templateNames}}" value="{{templateIndex}}" bindchange="templateChange"><view class="input picker">{{templateNames[templateIndex]}}</view></picker><text class="label">微信消息</text><textarea class="textarea message-input" value="{{content}}" bindinput="contentInput"/><text class="label">插入变量</text><view class="tokens"><view wx:for="{{builtIns}}" wx:key="name" class="token" data-name="{{item.name}}" bindtap="insertVariable">{{item.label}}</view><view wx:for="{{variables}}" wx:key="id" class="token custom" data-name="{{item.name}}" bindtap="insertVariable">{{item.displayName}}</view></view></view>
  <view class="card"><view class="row between"><view class="card-title">02 · 选择好友</view><text class="small muted">{{total}} 人</text></view><view wx:for="{{selections}}" wx:for-item="selection" wx:for-index="accountIndex" wx:key="id" class="account-block"><view class="row between account-title"><view>{{selection.name}}</view><text class="small muted">{{selection.selectedCount}}/{{selection.friends.length}}</text></view><view class="segments"><view wx:for="{{selection.groups}}" wx:for-item="segment" wx:for-index="segmentIndex" wx:key="id" class="segment" data-account-index="{{accountIndex}}" data-kind="groups" data-index="{{segmentIndex}}" bindtap="selectSegment">分组 · {{segment.name}} · {{segment.friendIds.length}}</view><view wx:for="{{selection.tags}}" wx:for-item="segment" wx:for-index="segmentIndex" wx:key="id" class="segment tag" data-account-index="{{accountIndex}}" data-kind="tags" data-index="{{segmentIndex}}" bindtap="selectSegment">#{{segment.name}} · {{segment.friendIds.length}}</view></view><view class="friend-grid"><view wx:for="{{selection.friends}}" wx:for-item="friend" wx:for-index="friendIndex" wx:key="id" class="friend {{friend.selected ? 'selected' : ''}}" data-account-index="{{accountIndex}}" data-friend-index="{{friendIndex}}" bindtap="toggleFriend"><view class="box">{{friend.selected ? '✓' : ''}}</view><text>{{friend.remark}}</text></view></view><view wx:if="{{selection.selectedCount}}" class="delay"><view><text class="label">最小间隔</text><input class="input" type="number" value="{{selection.minDelay}}" data-account-index="{{accountIndex}}" data-key="minDelay" bindinput="delayInput"/></view><view><text class="label">最大间隔</text><input class="input" type="number" value="{{selection.maxDelay}}" data-account-index="{{accountIndex}}" data-key="maxDelay" bindinput="delayInput"/></view></view></view></view>
  <view class="card"><view class="card-title">03 · 开始时间</view><view class="timing"><view class="choice {{timing === 'now' ? 'selected' : ''}}" data-value="now" bindtap="timingChange">立即发送</view><view class="choice {{timing === 'later' ? 'selected' : ''}}" data-value="later" bindtap="timingChange">单次定时</view></view><view wx:if="{{timing === 'later'}}" class="date-row"><picker mode="date" value="{{date}}" bindchange="dateChange"><view class="input picker">{{date}}</view></picker><picker mode="time" value="{{time}}" bindchange="timeChange"><view class="input picker">{{time}}</view></picker></view></view>
  <view class="notice">提交前将显示第一位好友的最终文案。所有变量结果、候选值和收件顺序随后冻结。</view><button class="button submit" loading="{{busy}}" bindtap="submit">预览并确认 · {{total}} 人</button>
</view>
