<view class="page"><view class="eyebrow">WECHAT PAY</view><view class="title">确认付款</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:elif="{{paid}}" class="card success"><view class="amount">已完成</view><view class="subtitle">支付结果已提交，感谢使用。</view></view><view wx:elif="{{order}}" class="card"><view class="label">订单描述</view><view class="order-title">{{order.description}}</view><view class="amount">¥{{(order.amountFen / 100).toFixed(2)}}</view><view class="small muted">订单有效期至 {{order.expiresAt}}</view><button class="button submit" loading="{{loading}}" bindtap="pay">微信支付</button></view><view wx:else class="empty">正在读取订单…</view></view>
