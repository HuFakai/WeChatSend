<view class="page"><view class="row between"><view><view class="eyebrow">CHANNELS</view><view class="title">发送账号</view></view><button class="button small" bindtap="toggleForm">{{showForm ? '取消' : '添加'}}</button></view><view class="subtitle">一个账号对应一台 iPhone 和一个接收邮箱。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{showForm}}" class="card"><view class="card-title">{{editingId ? '编辑账号' : '添加账号'}}</view><text class="label">账号名称</text><input class="input" value="{{form.name}}" data-key="name" bindinput="formInput" placeholder="例如：销售一号机"/><text class="label">接收邮箱</text><input class="input" value="{{form.recipientEmail}}" data-key="recipientEmail" bindinput="formInput" placeholder="name@example.com"/><text class="label">邮件主题</text><input class="input" value="{{form.subject}}" data-key="subject" bindinput="formInput"/><view class="delay"><view><text class="label">最小间隔</text><input class="input" type="number" min="10" value="{{form.minDelay}}" data-key="minDelay" bindinput="formInput"/></view><view><text class="label">最大间隔</text><input class="input" type="number" min="10" value="{{form.maxDelay}}" data-key="maxDelay" bindinput="formInput"/></view></view><button class="button submit" loading="{{busy}}" bindtap="create">保存账号</button></view>
  <view wx:if="{{!items.length && !showForm}}" class="empty">还没有发送账号<br/>点击右上角添加</view>
  <view wx:for="{{items}}" wx:key="id" class="card account"><view class="row between"><view><view class="card-title">{{item.name}}</view><view class="small muted email">{{item.recipientEmail}}</view></view><view class="badge">{{item.status === 'ACTIVE' ? '使用中' : '已停用'}}</view></view><view class="meta"><text>{{item._count.friends}} 位好友</text><text>{{item.minDelay}}–{{item.maxDelay}} 秒</text></view><view class="actions"><button wx:if="{{!item.emailVerifiedAt}}" class="button secondary small" data-id="{{item.id}}" bindtap="verify">验证邮箱</button><text wx:else class="verified">✓ 邮箱已验证</text><view class="row"><button class="button secondary small action" data-index="{{index}}" bindtap="edit">编辑</button><button class="button secondary small action" data-id="{{item.id}}" data-status="{{item.status}}" bindtap="toggle">{{item.status === 'ACTIVE' ? '停用' : '启用'}}</button></view></view></view>
</view>
