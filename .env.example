# PostgreSQL（远程连接通常需要放行 5432 端口）
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/wechatsend?schema=public"
DB_CONNECTION_LIMIT=4
DB_POOL_TIMEOUT=20

# Redis / BullMQ
REDIS_URL="redis://127.0.0.1:6379"
WORKER_CONCURRENCY=4

# API
API_PORT=3100
APP_ORIGIN="http://localhost:5173"
SESSION_TTL_DAYS=30
WEB_PORT=8080

# 平台发信邮箱。QQ 邮箱 465 端口使用 true；587 使用 false。
SMTP_HOST="smtp.qq.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_MAX_CONNECTIONS=1
SMTP_CONNECTION_TIMEOUT_MS=20000
SMTP_SOCKET_TIMEOUT_MS=60000

# 邮件触发主题与验证邮件主题必须不同
DEFAULT_TRIGGER_SUBJECT="WeChatSend"
VERIFY_SUBJECT="WeChatSend 邮箱验证（请勿触发快捷指令）"

# AI 通道及支付密钥只放在服务端，至少 32 位；AI 通道本身在管理员后台配置。
APP_ENCRYPTION_KEY="请生成至少32位随机字符串"
AI_REQUEST_TIMEOUT_MS=45000

# 微信小程序身份登录。小程序 AppID/Secret 从微信公众平台获取。
WECHAT_MINI_APPID=""
WECHAT_MINI_SECRET=""
WECHAT_MINI_ENV_VERSION=release

# 微信支付 V3（扫码进入小程序后调起 JSAPI 支付）。未启用支付时可以留空。
WECHAT_PAY_MCH_ID=""
WECHAT_PAY_SERIAL_NO=""
WECHAT_PAY_PRIVATE_KEY=""
WECHAT_PAY_API_V3_KEY=""
WECHAT_PAY_PLATFORM_CERT=""
WECHAT_PAY_NOTIFY_URL="https://你的域名/api/v1/payments/notify"
